<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFF5F0EB" />
            <stroke
                android:width="1dp"
                android:color="#8B6B4A" />
            <corners android:radius="20dp" />
            <padding
                android:left="12dp"
                android:right="12dp"
                android:top="4dp"
                android:bottom="4dp" />
        </shape>
    </item>
</selector>
