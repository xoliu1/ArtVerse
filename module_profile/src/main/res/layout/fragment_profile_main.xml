<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".fragment_profile_main"
    android:background="#F6F0F0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg111">
            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardCornerRadius="90dp">
            <ImageView
                android:id="@+id/profileUserIcon"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:clickable="true"
                android:src="@drawable/wechat_icon"/>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/profileUserName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:textSize="27sp"
                android:textColor="@color/white"
                android:text="xoliu"/>



        </LinearLayout>



        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"

            android:padding="10dp"

            >

            <LinearLayout
                android:id="@+id/profileAssistant"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@color/white"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/xiaoxi"/>
                <TextView
                    android:layout_marginTop="5dp"
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:textColor="@color/peru"
                    android:gravity="center"
                    android:fontFamily="@font/font2"
                    android:text="助手"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/profileNote"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_height="match_parent"
                android:background="@color/white"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_note"/>
                <TextView
                    android:layout_marginTop="5dp"
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:textColor="@color/peru"
                    android:gravity="center"
                    android:fontFamily="@font/font2"
                    android:text="笔记"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/profileNearby"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_height="match_parent"
                android:background="@color/white"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/zhoubian"/>
                <TextView
                    android:layout_marginTop="5dp"
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:textColor="@color/peru"
                    android:gravity="center"
                    android:fontFamily="@font/font2"
                    android:text="周边"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/profileDiscover"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_height="match_parent"
                android:background="@color/white"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/find"/>
                <TextView
                    android:layout_marginTop="5dp"
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:textColor="@color/peru"
                    android:gravity="center"
                    android:fontFamily="@font/font2"
                    android:text="发现"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/profileFans"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_height="match_parent"
                android:background="@color/white"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/thank"/>
                <TextView
                    android:id="@+id/tvFansLabel"
                    android:layout_marginTop="5dp"
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:textColor="@color/peru"
                    android:gravity="center"
                    android:fontFamily="@font/font2"
                    android:text="粉丝"/>
            </LinearLayout>









        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="我所同感"
            android:textSize="26sp"
            android:gravity="center"
            android:fontFamily="@font/font2"
            android:background="@color/white"
            android:paddingBottom="20dp"
            android:paddingTop="10dp"
            android:textColor="@color/black"/>

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/profile_tabLayout"
            android:layout_height="50dp"
            android:layout_width="match_parent"
            app:tabIndicator="@drawable/tab_shape"
            app:tabIndicatorColor="@color/black"
            app:tabSelectedTextColor="@color/black"
            app:tabTextColor="@color/gray"
            >

            <com.google.android.material.tabs.TabItem
                android:text="文集"
                android:tooltipText="" />

            <com.google.android.material.tabs.TabItem
                android:text="画廊"
                android:tooltipText=""/>

        </com.google.android.material.tabs.TabLayout>
        <!-- 诗集列表（文集Tab内容，直接内嵌） -->
        <FrameLayout
            android:id="@+id/poem_content_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="300dp">

            <TextView
                android:id="@+id/emptyHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="40dp"
                android:text="暂无文集，点击右下角 + 创建"
                android:textSize="15sp"
                android:textColor="#999999"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/profilePoemRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabAdd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="24dp"
                android:src="@android:drawable/ic_input_add"
                android:contentDescription="添加文集"
                app:backgroundTint="#46a2ff"
                app:tint="@android:color/white"
                app:fabSize="normal"
                app:elevation="6dp" />
        </FrameLayout>

        <!-- 画廊列表（画廊Tab内容，直接内嵌） -->
        <FrameLayout
            android:id="@+id/art_content_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="300dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/artEmptyHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="40dp"
                android:text="暂无画作，点击右下角 + 添加"
                android:textSize="15sp"
                android:textColor="#999999"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/profileArtRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabAddGallery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="24dp"
                android:src="@android:drawable/ic_input_add"
                android:contentDescription="添加画作"
                app:backgroundTint="#8B4513"
                app:tint="@android:color/white"
                app:fabSize="normal"
                app:elevation="6dp" />
        </FrameLayout>

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="30dp"
            android:text="退出登录"
            android:textSize="16sp"
            android:textColor="@color/white"
            android:backgroundTint="#8B4513"
            android:fontFamily="@font/font2" />










    </LinearLayout>
</androidx.core.widget.NestedScrollView>