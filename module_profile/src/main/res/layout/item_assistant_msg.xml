<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent">

    <!-- AI助手消息（左侧，宽度随文字自适应） -->
    <LinearLayout
        android:id="@+id/assistant_left_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="60dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/assistant_bg_left"
        android:padding="12dp">

        <TextView
            android:id="@+id/assistant_left_msg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#333333"
            android:textSize="15sp"
            android:lineSpacingMultiplier="1.3" />

    </LinearLayout>

    <!-- 用户消息（右侧，宽度随文字自适应） -->
    <LinearLayout
        android:id="@+id/assistant_right_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="8dp"
        android:layout_marginStart="60dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/assistant_bg_right"
        android:padding="12dp">

        <TextView
            android:id="@+id/assistant_right_msg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:lineSpacingMultiplier="1.3" />

    </LinearLayout>

</FrameLayout>
